# Cổng máy chủ. Cố định 8089 cho môi trường phát triển của dự án này.
PORT=3000

# ============================================================================
# NHÀ CUNG CẤP AI
#
# AI chỉ trích xuất tín hiệu boolean. src/rule-engine.js mới quyết định mức
# rủi ro, và src/critical-override.js vẫn chạy kể cả khi AI hỏng hoặc bị
# thao túng. Đổi nhà cung cấp không đụng tới ranh giới đó.
#
# LLM_PROVIDER nhận: anthropic | gemini | openai   (mặc định: gemini)
# ============================================================================

# ---- Anthropic (Claude) — khuyến nghị --------------------------------------
# Ưu điểm so với hai đường kia: structured outputs BẢO ĐẢM đầu ra khớp lược đồ
# (không còn cảnh AI trả về văn xuôi rồi phải thử lại 3 lần), và đọc được PDF
# trực tiếp thay vì bắt bác chụp màn hình.
#
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
#
# Mã model mặc định: claude-haiku-4-5. Đổi bằng LLM_MODEL nếu cần.
#
# ⚠️ CỐ Ý KHÔNG đọc ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, ANTHROPIC_MODEL
#    hay ANTHROPIC_BASE_URL. Máy nào đang chạy Claude Code cũng có sẵn những
#    biến đó; đọc chúng là để ứng dụng âm thầm dùng khóa cá nhân và cấu hình
#    của công cụ khác. Mọi cấu hình của dự án nằm dưới tiền tố LLM_*.
#    Hàng rào: test/anthropic-provider.test.js

# ---- Gemini (mặc định hiện tại) ---------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ---- Gateway tương thích OpenAI ---------------------------------------------
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://.../v1
# LLM_MODEL=
