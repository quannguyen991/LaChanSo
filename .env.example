# --- Nhà cung cấp AI ---
# Mặc định dùng Gemini native (Google AI Studio). Chỉ trích xuất cờ tín hiệu;
# luật cứng trong code mới quyết định mức rủi ro.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Để dùng gateway OpenAI-compatible (vd vertex-key.com → Claude/GPT), đặt:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://vertex-key.com/api/v1
#   LLM_MODEL=aws/claude-haiku-4-5
#   LLM_API_KEY=vai-...
# (bỏ trống = dùng Gemini native ở trên). Nhánh openai chưa hỗ trợ đọc PDF.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

PORT=3000
# Bật khi chạy sau reverse proxy / Cloud Run để rate-limit theo đúng IP người dùng.
# Giá trị: "true", một số hop (vd "1"), hoặc subnet. Để trống khi chạy local.
TRUST_PROXY=
